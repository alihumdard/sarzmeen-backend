# ============================================================
# Sarzameen Backend — Environment Configuration
# ============================================================

APP_NAME=Sarzameen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend URL (used for CORS, sitemap, email links)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PK
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---- Logging ----
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_STACK=daily, LOG_LEVEL=error

# ---- Database (PostgreSQL) ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sarzameen
DB_USERNAME=postgres
DB_PASSWORD=

# ---- Session ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
# Production: SESSION_DOMAIN=.sarzameen.com, SESSION_SECURE_COOKIE=true

# ---- Queue ----
QUEUE_CONNECTION=database
# Production: QUEUE_CONNECTION=redis

# ---- Cache ----
CACHE_STORE=redis
# Fallback: CACHE_STORE=database

# ---- Redis ----
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Storage ----
FILESYSTEM_DISK=local
# Production: consider S3 for media storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
# AWS_BUCKET=sarzameen-media
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Mail ----
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sarzameen.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production: MAIL_MAILER=smtp (or ses/mailgun/postmark)

# ---- Sanctum (SPA auth) ----
SANCTUM_STATEFUL_DOMAINS=localhost:3000
# Production: SANCTUM_STATEFUL_DOMAINS=sarzameen.com,www.sarzameen.com

BROADCAST_CONNECTION=log
